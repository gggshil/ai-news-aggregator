# =================================================================
# AI NEWS AGGREGATOR - PRODUCTION ENVIRONMENT TEMPLATE
# =================================================================

# 1. Database (Supabase Free PostgreSQL)
# Example: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# 2. AI Intelligence (Google Gemini / OpenAI)
# Free API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Optional OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# 3. Email Delivery (Gmail SMTP)
# Your sending Gmail address
MY_EMAIL=your_email@gmail.com
# 16-character Google App Password (Generated at https://myaccount.google.com/apppasswords)
APP_PASSWORD=abcd efgh ijkl mnop

# 4. Security & CORS Settings
# Set to "PRODUCTION" when running in the cloud
ENVIRONMENT=PRODUCTION
# Comma-separated list of allowed origins (e.g. your Flutter Web URL or "*")
ALLOWED_ORIGINS=*
# Optional secret token to protect cron webhooks
CRON_SECRET=your_custom_secure_cron_token_here
